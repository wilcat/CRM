# Copie este arquivo para ".env" e ajuste os valores.
# O servidor le essas variaveis automaticamente ao iniciar (via `dotenv`,
# ja incluso). Se preferir, pode tambem exportar essas variaveis direto no
# shell/systemd em vez de usar um arquivo .env.

# --- Banco de dados ---
# Se DATABASE_URL estiver definida, o sistema usa PostgreSQL.
# Se ela NAO estiver definida, o sistema usa o arquivo local
# data/database.json (bom só para testes rápidos, sem instalar nada).
DATABASE_URL=postgres://fluxo:SUA_SENHA_AQUI@localhost:5432/fluxo_erp

# --- Autenticacao ---
# Troque por uma string longa e aleatoria em producao.
# Gerar uma rapida: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# --- Servidor ---
PORT=3000

# --- Cupom / QR Code de acompanhamento de pedido ---
# Endereço que o QR Code do cupom vai apontar. Use o IP (ou domínio) que os
# CLIENTES vão acessar pelo celular — normalmente o IP da rede interna do
# servidor, não "localhost" (senão o QR só funciona escaneado na própria
# máquina do servidor). Exemplo: http://192.168.0.15:3000
PUBLIC_URL=http://localhost:3000
